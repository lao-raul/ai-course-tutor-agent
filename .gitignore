# Secrets — never commit. .env.example is the only tracked template.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.local/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
coverage/
build/
apps/web/test-results/
apps/web/playwright-report/

# Runtime development data — course material never enters source control.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# OS
.DS_Store
