{
  "openapi": "3.1.0",
  "info": {
    "title": "Course Tutor Practice API",
    "version": "1.0.0",
    "description": "Hiruzen default StudyPlans and asynchronous practice generation jobs."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "practiceHealth",
                "x-implementation-status": "implemented",
        "security": [],
        "responses": {"200": {"description": "Process is alive", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}
      }
    },
    "/readyz": {
      "get": {
        "operationId": "practiceReady",
                "x-implementation-status": "implemented",
        "security": [],
        "responses": {"200": {"description": "Dummy service is ready"}, "503": {"description": "A required dependency is unavailable"}}
      }
    },
    "/v1/practice/capabilities": {
      "get": {
        "operationId": "getPracticeCapabilities",
                "x-implementation-status": "implemented",
        "responses": {"200": {"description": "Current practice capabilities", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Capabilities"}}}}}
      }
    },
    "/v1/practice/catalog/categories": {
      "get": {
        "operationId": "listPracticeCategories",
        "x-implementation-status": "implemented",
        "responses": {"200": {"description": "Authorized textbook category facets"}}
      }
    },
    "/v1/practice/catalog/books": {
      "get": {
        "operationId": "searchPracticeBooks",
        "x-implementation-status": "implemented",
        "parameters": [
          {"name": "q", "in": "query", "schema": {"type": "string"}},
          {"name": "education_level", "in": "query", "schema": {"type": "string"}},
          {"name": "grade", "in": "query", "schema": {"type": "string"}},
          {"name": "subject", "in": "query", "schema": {"type": "string"}},
          {"name": "publisher", "in": "query", "schema": {"type": "string"}},
          {"name": "edition", "in": "query", "schema": {"type": "string"}},
          {"name": "term", "in": "query", "schema": {"type": "string"}},
          {"name": "language", "in": "query", "schema": {"type": "string"}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}
        ],
        "responses": {"200": {"description": "Published authorized books with an opaque next cursor"}}
      }
    },
    "/v1/practice/catalog/books/{book_id}": {
      "parameters": [{"$ref": "#/components/parameters/BookId"}],
      "get": {
        "operationId": "getPracticeBook",
        "x-implementation-status": "implemented",
        "responses": {"200": {"description": "Published book detail"}, "404": {"description": "Book not found or unauthorized"}}
      }
    },
    "/v1/practice/catalog/books/{book_id}/courses": {
      "parameters": [{"$ref": "#/components/parameters/BookId"}],
      "get": {
        "operationId": "listBookCourses",
        "x-implementation-status": "implemented",
        "responses": {"200": {"description": "Authorized published system CourseRuns"}, "404": {"description": "Book not found or unauthorized"}}
      }
    },
    "/v1/practice/catalog/books/{book_id}/study-plan": {
      "parameters": [{"$ref": "#/components/parameters/BookId"}],
      "get": {
        "operationId": "getBookStudyPlan",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {"description": "Deterministic default StudyPlan for the published Book version"},
          "404": {"description": "Book not found or unauthorized"},
          "409": {"description": "Book has no published CourseRun"}
        }
      }
    },
    "/v1/practice/catalog/books/{book_id}/generations": {
      "parameters": [
        {"$ref": "#/components/parameters/BookId"},
        {"$ref": "#/components/parameters/IdempotencyKey"}
      ],
      "post": {
        "operationId": "createPracticeGeneration",
        "x-implementation-status": "implemented",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GenerateRequest"}}}},
        "responses": {
          "202": {"description": "Generation job accepted or idempotently replayed"},
          "422": {"description": "Invalid generation scope or request"}
        }
      }
    },
    "/v1/practice/generations/{generation_id}": {
      "parameters": [{"$ref": "#/components/parameters/GenerationId"}],
      "get": {
        "operationId": "getPracticeGeneration",
        "x-implementation-status": "implemented",
        "responses": {"200": {"description": "Learner-owned generation status"}, "404": {"description": "Generation not found"}}
      }
    },
    "/v1/practice/generations/{generation_id}/cancel": {
      "parameters": [{"$ref": "#/components/parameters/GenerationId"}],
      "post": {
        "operationId": "cancelPracticeGeneration",
        "x-implementation-status": "implemented",
        "responses": {"200": {"description": "Cancelled or terminal generation"}, "404": {"description": "Generation not found"}}
      }
    },
    "/v1/practice/sets/{set_id}": {
      "parameters": [{"$ref": "#/components/parameters/PracticeSetId"}],
      "get": {
        "operationId": "getPracticeSet",
        "x-implementation-status": "implemented",
        "responses": {
          "200": {"description": "Learner-safe PracticeSet without protected answers"},
          "404": {"description": "PracticeSet not found"}
        }
      }
    },
    "/v1/practice/courses/{course_id}/exercises:generate": {
      "parameters": [
        {"$ref": "#/components/parameters/CourseId"},
        {"$ref": "#/components/parameters/IdempotencyKey"}
      ],
      "post": {
        "operationId": "generatePracticeExercises",
        "deprecated": true,
        "x-implementation-status": "implemented",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GenerateRequest"}}}},
        "responses": {
          "401": {"description": "Authentication required"},
          "403": {"description": "Course is outside the authenticated scope"},
          "409": {"description": "Default Book StudyPlan has not been initialized"},
          "422": {"description": "Invalid generation request"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {
      "BookId": {"name": "book_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "CourseId": {"name": "course_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "GenerationId": {"name": "generation_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "PracticeSetId": {"name": "set_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 255}}
    },
    "schemas": {
      "Health": {"type": "object", "required": ["status", "service", "version", "revision"], "properties": {"status": {"const": "ok"}, "service": {"const": "practice-api"}, "version": {"type": "string"}, "revision": {"type": "string"}}},
      "Capabilities": {"type": "object", "required": ["exercise_generation", "implemented_features"], "properties": {"exercise_generation": {"const": "asynchronous_jobs"}, "implemented_features": {"type": "array", "items": {"type": "string"}}}},
      "GenerateRequest": {"type": "object", "additionalProperties": false, "properties": {"count": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5}, "course_id": {"type": ["string", "null"], "format": "uuid"}, "study_plan_id": {"type": ["string", "null"], "format": "uuid"}, "module_id": {"type": ["string", "null"], "format": "uuid"}, "topic": {"type": ["string", "null"]}, "difficulty": {"enum": ["introductory", "standard", "challenge"], "default": "standard"}, "question_types": {"type": "array", "items": {"enum": ["multiple_choice", "true_false", "fill_in_the_blank", "short_answer"]}}, "language": {"enum": ["zh", "en", "bilingual"], "default": "zh"}}}
    }
  }
}
