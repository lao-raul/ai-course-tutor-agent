{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["backend", "config", "secrets", "worker", "web"],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "imagePullSecrets": {"type": "array"},
        "buildRevision": {"type": "string"}
      }
    },
    "backend": {
      "type": "object",
      "required": ["replicas", "agent", "practice"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "agent": {"$ref": "#/definitions/workload"},
        "practice": {"$ref": "#/definitions/workload"}
      }
    },
    "worker": {"$ref": "#/definitions/optionalWorkload"},
    "web": {"$ref": "#/definitions/optionalWorkload"},
    "fakeLlm": {"$ref": "#/definitions/optionalWorkload"},
    "config": {
      "type": "object",
      "required": ["environment", "authMode", "postgresDsn", "redisUrl", "qdrantUrl", "llmBaseUrl"],
      "properties": {
        "environment": {"enum": ["local", "test", "production"]},
        "authMode": {"enum": ["local", "oidc"]},
        "postgresDsn": {"type": "string", "minLength": 1},
        "redisUrl": {"type": "string", "minLength": 1},
        "qdrantUrl": {"type": "string", "minLength": 1},
        "llmBaseUrl": {"type": "string", "minLength": 1, "pattern": "/v1/?$"},
        "llmChatModel": {"type": "string", "minLength": 1},
        "llmEmbeddingModel": {"type": "string", "minLength": 1},
        "llmEmbeddingDimension": {"type": "integer", "minimum": 1},
        "memoryExtractionInterval": {"type": "integer", "minimum": 1, "maximum": 20},
        "chatTurnRetentionDays": {"type": "integer", "minimum": 1, "maximum": 365},
        "sessionSummaryRetentionDays": {"type": "integer", "minimum": 1, "maximum": 730}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {"existingSecret": {"type": "string"}}
    },
    "courseContent": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "createPvc": {"type": "boolean"},
        "storageClassName": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "anyOf": [
              {"properties": {"createPvc": {"const": true}}},
              {"properties": {"existingClaim": {"type": "string", "minLength": 1}}}
            ]
          }
        }
      ]
    },
    "ciFixture": {
      "type": "object",
      "required": ["enabled", "mountPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string"}
      }
    },
    "workload": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "optionalWorkload": {
      "allOf": [
        {"$ref": "#/definitions/workload"},
        {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
      ]
    }
  }
}
