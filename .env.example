# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
SERVICE_NAME=course-tutor
BUILD_VERSION=0.1.0-dev
BUILD_REVISION=unknown
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Inference -----------------------------------------------------------------
# LM Studio exposes an OpenAI-compatible API. Do not append /chat/completions here.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_CHAT_MODEL=qwen/qwen3.6-35b-a3b
LLM_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
# Must match what the embedding model actually returns; the provider fails closed
# on a mismatch. text-embedding-qwen3-embedding-0.6b returns 1024.
LLM_EMBEDDING_DIMENSION=1024

# --- Course sources ------------------------------------------------------------
# Mount the SMB share via the OS first (read-only service account), then set the
# resulting local POSIX mount point — not the NAS-internal share path.
# macOS example: /Volumes/CourseContent/modules
COURSE_SOURCE_PATH=

# --- Authentication -----------------------------------------------------------
# local is allowed only for local/test. The tenant ID must already exist in Postgres.
AUTH_MODE=local
LOCAL_AUTH_TOKEN=local-dev-token
LOCAL_TENANT_ID=00000000-0000-0000-0000-000000000001
LOCAL_TENANT_SLUG=local
LOCAL_TENANT_NAME=Local Development
LOCAL_USER_ID=00000000-0000-0000-0000-000000000002
LOCAL_USER_DISPLAY_NAME=Local Developer
LOCAL_USER_ROLE=platform_admin
LOCAL_ACCESS_LABEL=restricted
# Production: set AUTH_MODE=oidc and configure all three values.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256

# --- State stores --------------------------------------------------------------
POSTGRES_DSN=postgresql+asyncpg://course_tutor:course_tutor@localhost:5432/course_tutor
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6380/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=course-tutor
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=course-tutor-artifacts

# --- Ingestion ----------------------------------------------------------------
INGESTION_SCAN_INTERVAL_SECONDS=900
INGESTION_POLL_INTERVAL_SECONDS=5
INGESTION_MAX_ATTEMPTS=5

# --- Compose host ports --------------------------------------------------------
# Change these if another local stack already owns the default port.
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Observability -------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
